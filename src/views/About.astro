---
import Layout from '../layouts/Layout.astro';
import type { Lang } from '../i18n';

interface Props { lang: Lang; }
const { lang } = Astro.props;

const copy = {
  zh: {
    title: '关于 | 汪宸',
    heading: '关于',
    education: '教育经历',
    items: [
      { years: '2022–今', school: '莱比锡大学', degree: '化学 · 博士在读' },
      { years: '2018–2021', school: '江南大学', degree: '材料工程 · 硕士' },
      { years: '2013–2017', school: '江南大学', degree: '高分子材料与工程 · 学士' },
    ],
  },
  en: {
    title: 'About | Chen Wang',
    heading: 'About',
    education: 'Education',
    items: [
      { years: '2022–now', school: 'Leipzig University', degree: 'PhD candidate, Chemistry' },
      { years: '2018–2021', school: 'Jiangnan University', degree: 'M.Eng., Materials Engineering' },
      { years: '2013–2017', school: 'Jiangnan University', degree: 'B.Eng., Polymer Materials and Engineering' },
    ],
  },
}[lang];
---

<Layout title={copy.title} lang={lang}>
  <style>
    .timeline { list-style: none; padding: 0; margin: 0; }
    .timeline li { display: grid; grid-template-columns: 6.5rem minmax(0, 1fr); gap: 1rem; padding: 0.7rem 0; border-bottom: 1px solid var(--line); }
    .timeline li:last-child { border-bottom: none; }
    .timeline .label { padding-top: 0.3rem; }
    .timeline .school { font-weight: 500; }
    .timeline .degree { font-size: 0.88rem; color: var(--muted); }
  </style>

  <main class="page-main" data-pagefind-ignore>
    <header style="margin-bottom: 2.5rem;">
      <h1 class="page-title">{copy.heading}</h1>
    </header>

    <section class="section">
      <h2>{copy.education}</h2>
      <ul class="timeline">
        {copy.items.map(e => (
          <li>
            <span class="label">{e.years}</span>
            <div>
              <div class="school">{e.school}</div>
              <div class="degree">{e.degree}</div>
            </div>
          </li>
        ))}
      </ul>
    </section>
  </main>
</Layout>
