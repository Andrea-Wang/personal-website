    doi: '10.26434/chemrxiv.15009243/v1',
  },
  {
    authors: ['Domschke N.', 'Wang C.', 'Golnik R.', 'Charvat A.', 'Spesyvyi A.', 'Gatter T.', 'Abel B.', 'Stadler P. F.'],
    me: 1,
    title: 'Fragment Tree Reconciliation (FTR) for Space Applications',
